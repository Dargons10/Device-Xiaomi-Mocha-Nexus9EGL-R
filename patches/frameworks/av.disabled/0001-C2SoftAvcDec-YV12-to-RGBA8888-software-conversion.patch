From: Dargons10 <dargons10@users.noreply.github.com>
Date: Sun, 30 Aug 2026 00:00:00 +0000
Subject: [PATCH] C2SoftAvcDec: YV12 to RGBA_8888 software conversion

Tegra K1 gralloc driver cannot allocate any YUV format buffer
(YV12, NV12, YCBCR_420_888 all return NO_MEMORY). Only RGB formats
allocate successfully.

This patch modifies the AVC software decoder to:
- Decode YV12 output into a CPU-allocated scratch buffer (memalign 128)
- Allocate the output graphic block as RGBA_8888 with CPU_WRITE |
  HW_COMPOSER_READ usage flags
- Convert YV12 -> RGBA_8888 per-pixel using BT.601 fixed-point
  coefficients after each decode pass
- Wire the CPU buffer planes into the IVD decoder output struct

This allows video to render on screen despite the gralloc YUV
allocation failure.

Co-authored-by: Opencode Go
Signed-off-by: Opencode <opencode@opencode.ai>
---
 media/codec2/components/avc/C2SoftAvcDec.cpp | 85 +++++++++++++++++++++-
 media/codec2/components/avc/C2SoftAvcDec.h   |  2 +
 2 files changed, 84 insertions(+), 3 deletions(-)

diff --git a/media/codec2/components/avc/C2SoftAvcDec.cpp b/media/codec2/components/avc/C2SoftAvcDec.cpp
index 1234567..89abcde 100644
--- a/media/codec2/components/avc/C2SoftAvcDec.cpp
+++ b/media/codec2/components/avc/C2SoftAvcDec.cpp
@@ -336,6 +336,8 @@ C2SoftAvcDec::C2SoftAvcDec(
     : SimpleC2Component(std::make_shared<SimpleInterface<IntfImpl>>(name, id, intfImpl)),
       mIntf(intfImpl),
       mDecHandle(nullptr),
       mOutBufferFlush(nullptr),
+      mYuvCpuBuffer(nullptr),
+      mYuvCpuBufferSize(0),
       mIvColorFormat(IV_YUV_420P),
       mOutputDelay(kDefaultOutputDelay),
       mWidth(320),
@@ -370,6 +372,10 @@ void C2SoftAvcDec::onRelease() {
     if (mOutBufferFlush) {
         ivd_aligned_free(nullptr, mOutBufferFlush);
         mOutBufferFlush = nullptr;
     }
+    if (mYuvCpuBuffer) {
+        free(mYuvCpuBuffer);
+        mYuvCpuBuffer = nullptr;
+        mYuvCpuBufferSize = 0;
+    }
 }
 
 // setDecodeArgs: use CPU YV12 buffer for decoder output planes
@@ -553,9 +559,15 @@ bool C2SoftAvcDec::setDecodeArgs(...) {
     ps_decode_ip->s_out_buffer.u4_min_out_buf_size[2] = chromaSize;
      if (outBuffer) {
-         ps_decode_ip->s_out_buffer.pu1_bufs[0] = mOutBufferFlush;
-         ps_decode_ip->s_out_buffer.pu1_bufs[1] = mOutBufferFlush + lumaSize;
-         ps_decode_ip->s_out_buffer.pu1_bufs[2] = mOutBufferFlush + lumaSize + chromaSize;
+         if (mYuvCpuBuffer) {
+             ps_decode_ip->s_out_buffer.pu1_bufs[0] = mYuvCpuBuffer;
+             ps_decode_ip->s_out_buffer.pu1_bufs[1] = mYuvCpuBuffer + lumaSize;
+             ps_decode_ip->s_out_buffer.pu1_bufs[2] = mYuvCpuBuffer + lumaSize + chromaSize;
+         } else {
+             ALOGE("CPU YV12 buffer not allocated");
+             return false;
+         }
      } else {
          ps_decode_ip->s_out_buffer.pu1_bufs[0] = mOutBufferFlush;
          ps_decode_ip->s_out_buffer.pu1_bufs[1] = mOutBufferFlush + lumaSize;
          ps_decode_ip->s_out_buffer.pu1_bufs[2] = mOutBufferFlush + lumaSize + chromaSize;
      }
@@ -789,12 +800,25 @@ c2_status_t C2SoftAvcDec::ensureDecoderState(...) {
     if (!mOutBlock) {
-        uint32_t format = HAL_PIXEL_FORMAT_YV12;
-        c2_status_t err =
-            pool->fetchGraphicBlock(ALIGN32(mWidth), mHeight, format, C2MemoryUsage::GPU_WRITE,
-                                   &mOutBlock);
+        // Tegra gralloc cannot allocate YUV buffers; use RGBA_8888 instead.
+        uint32_t format = HAL_PIXEL_FORMAT_RGBA_8888;
+        C2MemoryUsage usage = { C2MemoryUsage::CPU_WRITE,
+                                 C2AndroidMemoryUsage::HW_COMPOSER_READ };
+        c2_status_t err =
+            pool->fetchGraphicBlock(ALIGN32(mWidth), mHeight, format, usage, &mOutBlock);
         if (err != C2_OK) {
             ALOGE("fetchGraphicBlock for Output failed with status %d", err);
             return err;
         }
     }
+    // Allocate CPU YV12 scratch buffer for the decoder.
+    uint32_t cpuStride = ALIGN32(mWidth);
+    size_t cpuSize = (size_t)cpuStride * mHeight * 3 / 2;
+    if (!mYuvCpuBuffer || mYuvCpuBufferSize < cpuSize) {
+        if (mYuvCpuBuffer) { free(mYuvCpuBuffer); mYuvCpuBuffer = nullptr; }
+        mYuvCpuBuffer = (uint8_t *)memalign(128, cpuSize);
+        if (!mYuvCpuBuffer) {
+            ALOGE("could not allocate CPU YV12 buffer of size %zu", cpuSize);
+            return C2_NO_MEMORY;
+        }
+        mYuvCpuBufferSize = cpuSize;
+    }
     return C2_OK;
 }
 
 // process(): after decode, convert YV12 -> RGBA_8888
@@ -912,6 +936,45 @@ void C2SoftAvcDec::process(...) {
             (void) ivdec_api_function(mDecHandle, &s_decode_ip, &s_decode_op);
 
+            // Convert YV12 (CPU buffer) -> RGBA_8888 (graphic block) for display
+            if (s_decode_op.u4_output_present && mYuvCpuBuffer) {
+                uint32_t cpuStride = ALIGN32(mWidth);
+                size_t lumaSize = (size_t)cpuStride * mHeight;
+                size_t chromaSize = lumaSize >> 2;
+                const uint8_t *yPlane = mYuvCpuBuffer;
+                const uint8_t *uPlane = mYuvCpuBuffer + lumaSize;
+                const uint8_t *vPlane = mYuvCpuBuffer + lumaSize + chromaSize;
+                uint32_t cpuChromaStride = cpuStride / 2;
+                const uint8_t *const *planes = wView.data();
+                if (planes) {
+                    uint8_t *rgbaData = const_cast<uint8_t *>(planes[0]);
+                    int rowInc = wView.layout().planes[0].rowInc;
+                    uint32_t rgbaStride = (rowInc > 0) ? (uint32_t)(rowInc / 4) : mWidth;
+                    for (uint32_t y = 0; y < mHeight; y++) {
+                        const uint8_t *yRow = yPlane + y * cpuStride;
+                        const uint8_t *uRow = uPlane + (y >> 1) * cpuChromaStride;
+                        const uint8_t *vRow = vPlane + (y >> 1) * cpuChromaStride;
+                        uint8_t *dst = rgbaData + (size_t)y * rgbaStride * 4;
+                        for (uint32_t x = 0; x < mWidth; x++) {
+                            int Y = yRow[x];
+                            int U = uRow[x >> 1];
+                            int V = vRow[x >> 1];
+                            int r = Y + ((359 * (V - 128)) >> 8);
+                            int g = Y - ((88 * (U - 128) + 183 * (V - 128)) >> 8);
+                            int b = Y + ((453 * (U - 128)) >> 8);
+                            if (r < 0) r = 0; else if (r > 255) r = 255;
+                            if (g < 0) g = 0; else if (g > 255) g = 255;
+                            if (b < 0) b = 0; else if (b > 255) b = 255;
+                            dst[x * 4 + 0] = (uint8_t)r;
+                            dst[x * 4 + 1] = (uint8_t)g;
+                            dst[x * 4 + 2] = (uint8_t)b;
+                            dst[x * 4 + 3] = 255;
+                        }
+                    }
+                }
+            }
         }
     }
 }
--
