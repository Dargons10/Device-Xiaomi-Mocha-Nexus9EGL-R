# SurfaceFlinger acceso a dispositivos Tegra
allow surfaceflinger gpu_device:chr_file rw_file_perms;
allow surfaceflinger nvhost_device:chr_file rw_file_perms;
allow surfaceflinger sysfs:file r_file_perms;
allow surfaceflinger sysfs_soc:file { read open getattr };
allow surfaceflinger sysfs_device_platform:file { read open getattr };
allow surfaceflinger sysfs_soc:file { read open getattr };
allow surfaceflinger sysfs_device_platform:file { read open getattr };
allow hal_drm_default zygote_exec:file { read getattr open execute };


# HWC / Gralloc
allow hal_graphics_composer_default gpu_device:chr_file rw_file_perms;
allow hal_graphics_allocator_default gpu_device:chr_file rw_file_perms;
allow hal_graphics_allocator_default nvhost_device:chr_file rw_file_perms;

# Codecs C2.android
allow mediacodec gpu_device:chr_file rw_file_perms;
allow mediacodec nvhost_device:chr_file rw_file_perms;
allow mediacodec hal_graphics_allocator_default:fd use;
allow mediacodec surfaceflinger:fd use;
allow mediacodec hal_graphics_composer_default:fd use;

# Acceso al servicio codec
allow mediaserver codec_service:service_manager find;
allow mediacodec codec_service:service_manager find;

# Binder permisos entre c2.android.* y mediaserver
allow mediacodec mediaserver:binder call;
allow mediaserver mediacodec:binder transfer;
 
