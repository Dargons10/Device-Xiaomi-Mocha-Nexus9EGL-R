allow hal_graphics_composer_default device:dir r_dir_perms;

allow hal_graphics_composer_default hal_configstore_ISurfaceFlingerConfigs:hwservice_manager find;
allow hal_graphics_composer_default hal_configstore_default:binder call;
vndbinder_use(hal_graphics_composer_default);
allow hal_graphics_composer_default vndbinder_device:chr_file { read write ioctl };
allow hal_graphics_composer_default system_prop:file { read };
allow hal_graphics_composer_default default_prop:file { read };
allow hal_graphics_composer_default chr_file:device [read open ioctl];
allow hal_graphics_composer_default sysfs_graphics:file { read };
allow hal_graphics_composer_default /dev/dri:chr_file { read write open ioctl };
allow hal_graphics_composer_default /dev/nvidia*:chr_file { read write open ioctl };
allow hal_graphics_composer_default /dev/input/event*:chr_file { read open };
allow hal_graphics_composer_default self:tcp_socket { create connect };
allow hal_graphics_composer_default shm:mem { read write create };
allow hal_graphics_composer_default /var/log/some_log_file:file { write append };
allow hal_graphics_composer_default /path/to/library.so:file { read open };

# 允许 HAL 访问 vndbinder 和 sysfs
allow hal_graphics_composer_default vndbinder_device:chr_file { open ioctl write };
allow hal_graphics_composer_default sysfs:file { read open getattr };
allow surfaceflinger sysfs:file { read open getattr };
allow surfaceflinger dev:chr_file { open ioctl };

