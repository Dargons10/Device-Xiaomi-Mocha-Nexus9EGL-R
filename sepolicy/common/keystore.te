# Allow to write to nvfeedback log file
allow keystore anr_data_file:file write;

# 允许keystore2访问Keymint设备
allow keystore2 keymint_device:device { open read write };

# 允许访问HAL服务接口
allow keystore2 hwservice_manager:hwservice { find add };

# 允许读取安全配置文件
allow keystore2 system_data_file:file { read open };