allow init sysfs_ozmo:lnk_file read;
allow init sysfs_nvi2c:lnk_file read;

allow init functionfs:dir mounton;
allow init pstorefs:dir mounton;
allow init user_calib_file:dir mounton;
allow init rpx_file:dir mounton;
allow init factory_file:dir mounton;

allow init kernel:system module_request;

allow init self:capability sys_nice;

allow init fscheck_block_device:blk_file rw_file_perms;
allow init tmpfs:lnk_file { create_file_perms relabelfrom };

# Access to write debugfs
allow init debugfs:file write;

# For init to write to kmsg
userdebug_or_eng(`
allow init kmsg_device:chr_file write;
')

# alllow to write to sdhci node for init
allow init sysfs_mmc_host:lnk_file rw_file_perms;

# allow init to change power hints node
allow init sysfs_netcfg:lnk_file rw_file_perms;
allow init debugfs_cluster:file rw_file_perms;

#BT_Loader
type init_btloader_exec, exec_type, file_type;
type init_btloader, domain;

init_daemon_domain(init_btloader)

#Kernel
allow init kernel:system module_request;

#Sdcard
allow init tmpfs:lnk_file create;

#pstore
allow init pstorefs:dir mounton;

allow init ram_device:blk_file write;

allow init sysfs:file setattr;

allow init vendor_file:file execute_no_trans;

# 允许init进程在sysfs和cgroup目录读写
allow init sysfs:dir { read write open create };
allow init cgroup:file { read write open create };

# 允许init创建/acct/uid目录（日志中出现的失败操作）
allow init tmpfs:dir { create write };

# 允许init进程访问cgroup文件系统
allow init cgroupfs:file { read write };
allow init sysfs:file { read write };

