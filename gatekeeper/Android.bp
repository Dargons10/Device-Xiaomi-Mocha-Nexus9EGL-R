cc_library_shared {
    name: "gatekeeper.tegra",
    vendor: true,
    relative_install_path: "hw",
    
    srcs: [
        "module.cpp",
        "SoftGateKeeperDevice.cpp",
    ],
    
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wunused",
    ],
    
    shared_libs: [
        "libbinder",
        "libgatekeeper",
        "liblog",
        "libhardware",
        "libbase",
        "libutils",
        "libcrypto",
    ],
    
    static_libs: [
        "libscrypt_static",
    ],
    
    include_dirs: [
        "external/scrypt/lib/crypto",
    ],
}

